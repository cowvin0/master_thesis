#!/bin/bash

#PBS -N pcm_array

#PBS -J 0-41

#PBS -o logs/
#PBS -e logs/

#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=72:00:00


echo "Array job ID: $PBS_ARRAY_ID"
echo "Task ID: $PBS_ARRAY_INDEX"

cd "$PBS_O_WORKDIR" || exit 1

exec > logs/pcm_${PBS_JOBID}_${PBS_ARRAY_INDEX}.out
exec 2> logs/pcm_${PBS_JOBID}_${PBS_ARRAY_INDEX}.err


module purge

module load gcc/14.2.0
module load python/3.12.8
module load pcre2/10.44


export R_HOME=$HOME/master_thesis/ggkm/utils/R-4.4.3

export LD_LIBRARY_PATH=$R_HOME/lib:$LD_LIBRARY_PATH


source ~/venvs/master_thesis/bin/activate


echo "Python:"
which python
python --version


python -u -m ggkm.scripts.run_pcm_experiment
