#!/bin/bash
#PBS -N pcm_experiment
#PBS -o pcm_experiment.out
#PBS -e pcm_experiment.err

# Resources
# Adjust these according to your cluster limits
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=72:00:00


echo "Job started"
echo "Host: $(hostname)"
echo "Date: $(date)"


# Move to submission directory
cd $PBS_O_WORKDIR


# Load modules
module purge
module load gcc/14.2.0
module load python/3.12.8
module load cmake/4.1.2


# Activate environment
source ~/venvs/master_thesis/bin/activate


echo "Python:"
which python
python --version


# Run experiment

python -m ggkm.scripts.run_pcm_experiment


echo "Job finished"
echo "Date: $(date)"
