#!/bin/bash
#PBS -N pcm_experiment
#PBS -o pcm_experiment.out
#PBS -e pcm_experiment.err

#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=72:00:00

echo "Job started"
echo "Host: $(hostname)"
echo "Date: $(date)"

cd "$PBS_O_WORKDIR" || exit 1

module purge
module load gcc/14.2.0
module load python/3.12.8
module load pcre2/10.44

# Local R build
export R_HOME=$HOME/master_thesis/ggkm/utils/R-4.4.3
export LD_LIBRARY_PATH=$R_HOME/lib:$LD_LIBRARY_PATH

echo "R_HOME:"
echo $R_HOME

echo "LD_LIBRARY_PATH:"
echo $LD_LIBRARY_PATH

echo "Checking libR dependencies:"
ldd $R_HOME/lib/libR.so | grep "not found"

echo "Checking libspecfun dependencies:"
ldd $HOME/master_thesis/ggkm/utils/libspecfun.so | grep "not found"

source ~/venvs/master_thesis/bin/activate

echo "Python:"
which python
python --version

echo "Testing libspecfun:"
python -c "import ctypes; ctypes.CDLL('$HOME/master_thesis/ggkm/utils/libspecfun.so'); print('libspecfun OK')"

python -m ggkm.scripts.run_pcm_experiment

echo "Job finished"
echo "Date: $(date)"
